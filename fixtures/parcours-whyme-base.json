    "polices": {
      "titres": "inter",
      "texte": "inter"
    },
    "titresMajuscules": false,
    "couleurs": {
      "marque": "#242841",
      "bulle": "#F6F4F5",
      "visiteur": "#C4007A",
      "fond": "#FFFFFF",
      "texte": "#303136"
    },
    "fonds": [
      {
        "id": "blanc",
        "nom": "Blanc",
        "couleur": "#FFFFFF",
        "texte": "#303136"
      },
      {
        "id": "doux",
        "nom": "Gris doux",
        "couleur": "#F6F4F5",
        "texte": "#303136"
      },
      {
        "id": "nuit",
        "nom": "Nuit WhyMe",
        "couleur": "#242841",
        "couleurBas": "#1A1D30",
        "texte": "#FFFFFF"
      },
      {
        "id": "geste",
        "nom": "Geste WhyMe",
        "couleur": "#C4007A",
        "couleurBas": "#A3197F",
        "texte": "#FFFFFF"
      }
    ],
    "fondsEcrans": {
      "fin": "nuit"
    },
    "parlomix": {
      "ouverture": "{prenom} a des choses à dire",
      "jingle": "parlobox",
      "fond": "geste"
    }
  },
  "etapes": [
    {
      "id": "accueil",
      "type": "accueil",
      "titre": "À toi la parole.",
      "texte": "Face caméra, 2 minutes chrono.",
      "bulles": [
        "Salut ! Prêt à jouer le jeu ?",
        "4 questions, aucune bonne réponse, juste la tienne.",
        "Sois toi-même, les autres sont déjà pris."
      ],
      "bouton": "Je me lance",
      "bullesGrandes": true,
      "masquerClient": true
    },
    {
      "id": "toi",
      "type": "identification",
      "titre": "On commence simple : ton prénom ?",
      "texte": "Juste pour t'appeler par ton prénom.",
      "accord": true
    },
    {
      "id": "recevoir",
      "type": "recevoir",
      "titre": "Tu veux recevoir ta vidéo ?",
      "texte": "Pour la garder, ou la partager. Laisse ton e-mail, c'est facultatif.",
      "bouton": "Recevoir ma vidéo",
      "boutonNon": "Non merci",
      "proposerDiffusion": true
    },
    {
      "id": "cadrage",
      "type": "cadrage",
      "titre": "Place ton visage dans l'ovale",
      "proposerFloutage": true,
      "reperes": false,
      "conseils": [
        "Fais court : 15 à 25 s pour répondre selon les questions",
        "Fini ? Touche « Question suivante »",
        "Parle normalement"
      ],
      "conclusion": "Sois sincère, on adore ça !"
    },
    {
      "id": "q-coup-de-coeur",
      "type": "question",
      "titreCourt": "Coup de cœur",
      "texte": "Ton dernier achat coup de cœur, c'était quoi ?",
      "pistes": [
        "Ce que c'est",
        "Pourquoi tu as craqué",
        "Tu le referais ?"
      ],
      "dureeMaxSec": 20,
      "compteARebours": 10,
      "silenceArretSec": 3,
      "intitulePistes": "",
      "mentionTemps": "Tu as {lecture} s pour réfléchir, {duree} s pour répondre."
    },
    {
      "id": "q-fan",
      "type": "question",
      "titreCourt": "Fan",
      "texte": "Une marque que tu défendrais face à tes potes ?",
      "pistes": [
        "Laquelle",
        "Ce qu'elle fait mieux",
        "Depuis quand"
      ],
      "dureeMaxSec": 20,
      "compteARebours": 10,
      "silenceArretSec": 3,
      "intitulePistes": "",
      "mentionTemps": "Tu as {lecture} s pour réfléchir, {duree} s pour répondre."
    },
    {
      "id": "q-le-pire",
      "type": "question",
      "titreCourt": "Le pire",
      "texte": "Le pire service client de ta vie ?",
      "pistes": [
        "Ce qui s'est passé",
        "Ce qu'ils auraient dû faire",
        "Tu y es retourné ?"
      ],
      "dureeMaxSec": 15,
      "compteARebours": 10,
      "silenceArretSec": 3,
      "intitulePistes": "",
      "mentionTemps": "Tu as {lecture} s pour réfléchir, {duree} s pour répondre."
    },
    {
      "id": "q-incompris",
      "type": "question",
      "titreCourt": "Incompris",
      "texte": "Le produit que tu ne comprends pas qu'on vende encore ?",
      "pistes": [
        "Lequel",
        "Ce qui cloche",
        "Qui l'achète, selon toi ?"
      ],
      "dureeMaxSec": 20,
      "compteARebours": 10,
      "silenceArretSec": 3,
      "intitulePistes": "",
      "mentionTemps": "Tu as {lecture} s pour réfléchir, {duree} s pour répondre."
    },
    {
      "id": "fin",
      "type": "fin",
      "titre": "Merci {prenom}, c'était parfait !",
      "texte": "Tes réponses sont bien arrivées. Merci de les avoir données sans filtre.",
      "sortie": "Bonne suite de journée !",
      "retourAccueilSec": 10,
      "contact": "contact@parlobox.com"
    }
  ]
}
