{
  "name": "voxbox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Parlopop by whyme — plateforme de cabines vidéo d'avis consommateurs",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm test",
    "db:migrate:test": "wrangler d1 migrations apply DB --remote --env test",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:test": "wrangler deploy --env test",
    "deploy:prod": "wrangler deploy --env production",
    "dev": "wrangler dev --env dev",
    "e2e": "node --no-warnings test/e2e/parcours.e2e.ts",
    "cabine:local": "node --no-warnings test/e2e/serveur.ts 8787",
    "e2e:whyme": "node --no-warnings test/e2e/whyme.e2e.ts",
    "montage:local": "node --no-warnings montage/serveur.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
