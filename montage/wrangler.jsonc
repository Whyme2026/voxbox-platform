// Service de montage Why me (Cloudflare Containers, juridiction UE). Déploiement à part de la plateforme,
// une fois l'offre Workers payante activée (environ 5 $ par mois) :
//   npx wrangler deploy -c montage/wrangler.jsonc
//   npx wrangler secret put MONTAGE_CLE -c montage/wrangler.jsonc     (même valeur que le secret MONTAGE_CLE de voxbox-test)
// Puis, sur voxbox-test : variable MONTAGE_URL = adresse workers.dev de ce Worker, secret MONTAGE_CLE.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "voxbox-montage",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    // Plateformes autorisées à faire monter des vidéos (le secret n'est envoyé qu'à elles).
    "MONTAGE_API_AUTORISEES": "https://voxbox-test.laurent-7ed.workers.dev"
  },
  "containers": [
    {
      "class_name": "ConteneurMontage",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1",
      // Données personnelles : le conteneur ne tourne qu'en Europe.
      "constraints": { "jurisdiction": "eu" }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "MONTAGE", "class_name": "ConteneurMontage" }] },
  "exports": { "ConteneurMontage": { "type": "durable-object", "storage": "sqlite" } }
}
